# Entorno Compose. Conserva estos valores para la instalación PRO existente.
PU_COMPOSE_PROJECT_NAME=pokemon-universe
PU_DEPLOY_ENVIRONMENT=production
PU_HOST_PORT=8080
PU_IMAGE_TAG=latest
PU_SERVER_IMAGE=ghcr.io/matadoreru/pokemon-universe-server
PU_WEB_IMAGE=ghcr.io/matadoreru/pokemon-universe-web
PU_BACKEND_IMAGE=ghcr.io/matadoreru/pokemon-universe-backend

PU_POSTGRES_DB=pokemon_universe
PU_POSTGRES_USER=pokemon
PU_POSTGRES_VOLUME=pokemon_universe_postgres_data
PU_AVATAR_VOLUME=pokemon_universe_avatar_data
# Genera valores hexadecimales seguros para URL: openssl rand -hex 32
PU_POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
PU_JWT_SECRET=CAMBIA_ESTE_SECRETO_DE_AL_MENOS_32_CARACTERES

# Origen público exacto, sin barra final.
PU_PUBLIC_ORIGIN=https://pokemon.example.com
PU_SECURE_COOKIE=true
# Salas del backend Java en /ws: false hasta el corte 2D.
PU_ROOMS_ENABLED=false
PU_ROOM_MAX_PLAYERS=8
PU_RECONNECT_GRACE_MS=30000
PU_WATCHTOWER_ENABLE=false

# Desarrollo local sin Compose.
# El backend Java (npm run dev:backend) escucha en :8080 y reutiliza JWT_SECRET, COOKIE_SECURE,
# WEB_ORIGIN y RATE_LIMIT_DISABLED; la BD local está fijada en backend/src/main/resources/application-dev.yml.
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://pokemon:pokemon@localhost:5432/pokemon_universe?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
# Desactiva el rate limit global y de /api/auth (ignorado si NODE_ENV=production). Útil para E2E.
RATE_LIMIT_DISABLED=false
ROOM_MAX_PLAYERS=8
RECONNECT_GRACE_MS=30000
VITE_API_URL=http://localhost:3001

# Sincronización de datasets externos (solo DataSync accede a estas fuentes).
DATA_SYNC_ENABLED=true
DATA_SYNC_HOUR=6
DATA_SYNC_MINUTE=0
DATA_SYNC_TIMEZONE=Europe/Madrid
