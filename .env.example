# Entorno Compose. Conserva estos valores para la instalación PRO existente.
PU_COMPOSE_PROJECT_NAME=pokemon-universe
PU_DEPLOY_ENVIRONMENT=production
PU_HOST_PORT=8080
PU_IMAGE_TAG=latest
PU_WEB_IMAGE=ghcr.io/matadoreru/pokemon-universe-web
PU_BACKEND_IMAGE=ghcr.io/matadoreru/pokemon-universe-backend

PU_POSTGRES_DB=pokemon_universe
PU_POSTGRES_USER=pokemon
PU_POSTGRES_VOLUME=pokemon_universe_postgres_data
PU_AVATAR_VOLUME=pokemon_universe_avatar_data
# Genera valores hexadecimales seguros para URL: openssl rand -hex 32
PU_POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
PU_JWT_SECRET=CAMBIA_ESTE_SECRETO_DE_AL_MENOS_32_CARACTERES

# Origen público exacto, sin barra final.
PU_PUBLIC_ORIGIN=https://pokemon.example.com
PU_SECURE_COOKIE=true
PU_ROOM_MAX_PLAYERS=8
PU_RECONNECT_GRACE_MS=30000
PU_WATCHTOWER_ENABLE=false
# Hora diaria de la sincronización PokéAPI/TCGdex del backend. Salas (/ws), salas interrumpidas al arrancar y
# data-sync van siempre encendidos en compose.yaml; PU_ROOMS_ENABLED y PU_DATA_SYNC_ENABLED ya no se leen.
PU_DATA_SYNC_HOUR=6
PU_DATA_SYNC_MINUTE=0
PU_DATA_SYNC_TIMEZONE=Europe/Madrid

# Desarrollo local sin Compose: el backend Java (npm run dev:backend) en :8080 (PORT lo fija el script) y Vite en :5173
# con proxy de /api y /ws hacia él. La BD local está fijada en backend/src/main/resources/application-dev.yml.
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
# Desactiva el rate limit global y de /api/auth. Útil para E2E (Playwright lo pone a true).
RATE_LIMIT_DISABLED=false
ROOM_MAX_PLAYERS=8
RECONNECT_GRACE_MS=30000
# Resultados de una partida: si queda sesión, la sala sigue sola pasado este plazo (Playwright lo alarga).
ROOM_RESULTS_AUTO_CONTINUE_MS=20000
# Intro de cada partida antes de la primera ronda; termina antes si todos los jugadores pulsan «¡Listo!» (0 la quita).
ROOM_GAME_INTRO_MS=8000
# Sincronización con PokéAPI y TCGdex del backend Java: apagada en dev para no sincronizar en cada arranque
# (npm run db:seed la enciende una vez). Java lee también DATA_SYNC_HOUR, DATA_SYNC_MINUTE y DATA_SYNC_TIMEZONE.
# BACKEND_DATA_SYNC_ENABLED=false
DATA_SYNC_HOUR=6
DATA_SYNC_MINUTE=0
DATA_SYNC_TIMEZONE=Europe/Madrid
# Solo pruebas del backend Java: base de PokéAPI, origen de sprites y base de TCGdex (https; http solo hacia loopback).
# POKEAPI_BASE_URL=https://pokeapi.co/api/v2
# POKEAPI_SPRITE_BASE_URL=https://raw.githubusercontent.com
# TCGDEX_BASE_URL=https://api.tcgdex.net/v2/en

# Correo saliente (recuperar contraseña). Sin SMTP_HOST el backend solo registra los correos en su log.
# Local con Mailpit (npm run db:up; buzón en http://127.0.0.1:8025):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# PRO con Resend (smtp.resend.com, puerto 465 con TLS):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=<API key de Resend>
# MAIL_FROM="Pokémon Universe <no-responder@matadoreru.com>"
