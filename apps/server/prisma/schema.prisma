generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum RoomHistoryStatus {
  ACTIVE
  CLOSED
  INTERRUPTED
}

enum GameHistoryStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  INTERRUPTED
}

model User {
  id           String             @id @default(cuid())
  username     String             @unique
  email        String             @unique
  passwordHash String
  avatarSeed   String             @default("")
  avatarType   String             @default("DEFAULT")
  avatarValue  String?
  avatarVersion Int               @default(0)
  role         UserRole           @default(USER)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  stats        UserStats?
  gameStats    UserGameStats[]
  gameConfigs  UserGameConfig[]
  results      PlayerGameResult[]
  customCategories CustomCategory[]
  wouldYouRatherPrompts CustomWouldYouRatherPrompt[]
  hostedRooms  RoomHistory[]      @relation("RoomHost")
}

model UserGameConfig {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model CustomCategory {
  id             String   @id @default(cuid())
  userId         String
  text           String
  normalizedText String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedText])
  @@index([userId])
}

model CustomWouldYouRatherPrompt {
  id            String   @id @default(cuid())
  userId        String
  optionA       String
  optionB       String
  normalizedKey String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedKey])
  @@index([userId])
}

model UserStats {
  userId       String @id
  gamesPlayed  Int    @default(0)
  gamesWon     Int    @default(0)
  totalPoints  Int    @default(0)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserGameStats {
  id           String @id @default(cuid())
  userId       String
  gameId       String
  gamesPlayed  Int    @default(0)
  gamesWon     Int    @default(0)
  points       Int    @default(0)
  metrics      Json
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model GameHistory {
  id          String             @id @default(cuid())
  resultId    String             @unique
  roomHistoryId String?
  roomCode    String
  gameId      String
  playerCount Int
  config      Json
  status      GameHistoryStatus  @default(IN_PROGRESS)
  startedAt   DateTime
  endedAt     DateTime?
  roomHistory RoomHistory?       @relation(fields: [roomHistoryId], references: [id], onDelete: SetNull)
  results     PlayerGameResult[]

  @@index([status, startedAt])
  @@index([roomHistoryId])
  @@index([gameId, endedAt])
}

model RoomHistory {
  id              String            @id
  roomCode        String
  hostUserId      String?
  hostDisplayName String
  maxPlayers      Int
  status          RoomHistoryStatus @default(ACTIVE)
  closeReason     String?
  createdAt       DateTime
  endedAt         DateTime?
  updatedAt       DateTime          @updatedAt
  hostUser        User?             @relation("RoomHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  games           GameHistory[]

  @@index([status, createdAt])
  @@index([roomCode, createdAt])
  @@index([hostUserId])
}

model PlayerGameResult {
  id          String      @id @default(cuid())
  historyId   String
  userId      String?
  displayName String
  position    Int
  points      Int
  metrics     Json
  history     GameHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Pokemon {
  id                String   @id
  nationalDexNumber Int
  name              String
  generation        Int
  isDefault         Boolean  @default(true)
  sprite            String
  hp                Int      @default(0)
  attack            Int      @default(0)
  defense           Int      @default(0)
  specialAttack     Int      @default(0)
  specialDefense    Int      @default(0)
  speed             Int      @default(0)
  baseStatTotal     Int      @default(0)
  heightDecimeters Int      @default(0)
  weightHectograms Int      @default(0)
  legendaryStatus String   @default("NORMAL")
  color             String   @default("unknown")
  abilities         String[]
  names             Json?
  types             String[]
  evolutionStage    Int?
  evolutionStages   Int?
  levelUpMoves      PokemonLevelUpMove[]
  pokedexEntries    PokedexEntry[]
  updatedAt         DateTime @updatedAt

  @@index([generation])
  @@index([nationalDexNumber])
}

model PokedexEntry {
  id           String  @id
  pokemonId    String
  text         String
  language     String
  generation   Int
  version      String
  versionLabel String
  pokemon      Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)

  @@unique([pokemonId, language, version])
  @@index([pokemonId, language, generation])
}

model Move {
  id                String   @id
  name              String
  type              String
  category          String
  names             Json?
  learnsets         PokemonLevelUpMove[]
  updatedAt         DateTime @updatedAt
}

model PokemonLevelUpMove {
  pokemonId          String
  moveId             String
  referenceGeneration Int
  level              Int
  pokemon            Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  move               Move    @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@id([pokemonId, moveId, referenceGeneration, level])
  @@index([pokemonId, referenceGeneration, level])
  @@index([moveId])
}

model PokemonCatalogSync {
  key         String   @id
  version     Int
  completedAt DateTime @default(now()) @updatedAt
}
