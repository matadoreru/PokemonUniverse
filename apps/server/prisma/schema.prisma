generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum RoomHistoryStatus {
  ACTIVE
  CLOSED
  INTERRUPTED
}

enum GameHistoryStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  INTERRUPTED
}

enum DataSyncSource {
  POKEAPI
  TCGDEX
}

enum DataSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum DataSyncMode {
  INITIAL
  INCREMENTAL
  FULL
  PRICE_REFRESH
}

model User {
  id           String             @id @default(cuid())
  username     String             @unique
  email        String             @unique
  passwordHash String
  avatarSeed   String             @default("")
  avatarType   String             @default("DEFAULT")
  avatarValue  String?
  avatarVersion Int               @default(0)
  role         UserRole           @default(USER)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  stats        UserStats?
  gameStats    UserGameStats[]
  gameConfigs  UserGameConfig[]
  results      PlayerGameResult[]
  customCategories CustomCategory[]
  wouldYouRatherPrompts CustomWouldYouRatherPrompt[]
  hostedRooms  RoomHistory[]      @relation("RoomHost")
}

model UserGameConfig {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model CustomCategory {
  id             String   @id @default(cuid())
  userId         String
  text           String
  normalizedText String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedText])
  @@index([userId])
}

model CustomWouldYouRatherPrompt {
  id            String   @id @default(cuid())
  userId        String
  optionA       String
  optionB       String
  normalizedKey String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedKey])
  @@index([userId])
}

model UserStats {
  userId       String @id
  gamesPlayed  Int    @default(0)
  gamesWon     Int    @default(0)
  totalPoints  Int    @default(0)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserGameStats {
  id           String @id @default(cuid())
  userId       String
  gameId       String
  gamesPlayed  Int    @default(0)
  gamesWon     Int    @default(0)
  points       Int    @default(0)
  metrics      Json
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model GameHistory {
  id          String             @id @default(cuid())
  resultId    String             @unique
  roomHistoryId String?
  roomCode    String
  gameId      String
  playerCount Int
  config      Json
  status      GameHistoryStatus  @default(IN_PROGRESS)
  startedAt   DateTime
  endedAt     DateTime?
  roomHistory RoomHistory?       @relation(fields: [roomHistoryId], references: [id], onDelete: SetNull)
  results     PlayerGameResult[]

  @@index([status, startedAt])
  @@index([roomHistoryId])
  @@index([gameId, endedAt])
}

model RoomHistory {
  id              String            @id
  roomCode        String
  hostUserId      String?
  hostDisplayName String
  maxPlayers      Int
  status          RoomHistoryStatus @default(ACTIVE)
  closeReason     String?
  createdAt       DateTime
  endedAt         DateTime?
  updatedAt       DateTime          @updatedAt
  hostUser        User?             @relation("RoomHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  games           GameHistory[]

  @@index([status, createdAt])
  @@index([roomCode, createdAt])
  @@index([hostUserId])
}

model PlayerGameResult {
  id          String      @id @default(cuid())
  historyId   String
  userId      String?
  displayName String
  position    Int
  points      Int
  metrics     Json
  history     GameHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Pokemon {
  id                String   @id
  nationalDexNumber Int
  name              String
  generation        Int
  isDefault         Boolean  @default(true)
  sprite            String
  hp                Int      @default(0)
  attack            Int      @default(0)
  defense           Int      @default(0)
  specialAttack     Int      @default(0)
  specialDefense    Int      @default(0)
  speed             Int      @default(0)
  baseStatTotal     Int      @default(0)
  heightDecimeters Int      @default(0)
  weightHectograms Int      @default(0)
  legendaryStatus String   @default("NORMAL")
  color             String   @default("unknown")
  abilities         String[]
  names             Json?
  types             String[]
  evolutionStage    Int?
  evolutionStages   Int?
  levelUpMoves      PokemonLevelUpMove[]
  pokedexEntries    PokedexEntry[]
  speciesId         Int?
  species           PokemonSpecies? @relation(fields: [speciesId], references: [id], onDelete: SetNull)
  statRows          PokemonStat[]
  typeRows          PokemonTypeAssignment[]
  abilityRows       PokemonAbility[]
  assetReferences   PokemonAssetReference[]
  evolutionFrom     PokemonEvolution[] @relation("EvolutionFrom")
  evolutionTo       PokemonEvolution[] @relation("EvolutionTo")
  tcgCards          TcgCardPokemon[]
  sourceUpdatedAt   DateTime?
  metadata          Json?
  updatedAt         DateTime @updatedAt

  @@index([generation])
  @@index([nationalDexNumber])
  @@index([speciesId])
}

model PokemonGeneration {
  id          Int      @id
  slug        String   @unique
  name        String
  mainRegion  String?
  metadata    Json?
  species     PokemonSpecies[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PokemonSpecies {
  id                   Int      @id
  slug                 String   @unique
  generationId         Int
  name                  String
  names                 Json?
  color                 String?
  shape                 String?
  habitat               String?
  growthRate            String?
  genderRate            Int?
  captureRate           Int?
  baseHappiness         Int?
  hatchCounter          Int?
  isBaby                Boolean  @default(false)
  isLegendary           Boolean  @default(false)
  isMythical            Boolean  @default(false)
  hasGenderDifferences  Boolean  @default(false)
  formsSwitchable       Boolean  @default(false)
  evolvesFromSpeciesId  Int?
  evolutionChainId      Int?
  footprintUrl          String?
  metadata              Json?
  generation            PokemonGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  forms                 Pokemon[]
  pokedexNumbers        PokemonPokedexNumber[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([generationId])
  @@index([evolutionChainId])
}

model PokemonPokedexNumber {
  speciesId  Int
  pokedex     String
  entryNumber Int
  species    PokemonSpecies @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@id([speciesId, pokedex])
  @@index([pokedex, entryNumber])
}

model PokemonStat {
  pokemonId String
  stat      String
  baseValue Int
  effort    Int      @default(0)
  pokemon   Pokemon  @relation(fields: [pokemonId], references: [id], onDelete: Cascade)

  @@id([pokemonId, stat])
  @@index([stat, baseValue])
}

model PokemonType {
  id        String   @id
  name      String
  names     Json?
  metadata  Json?
  pokemon   PokemonTypeAssignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PokemonTypeAssignment {
  pokemonId String
  typeId    String
  slot      Int
  pokemon   Pokemon     @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  type      PokemonType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@id([pokemonId, typeId])
  @@unique([pokemonId, slot])
  @@index([typeId])
}

model Ability {
  id        String   @id
  name      String
  names     Json?
  effect    Json?
  metadata  Json?
  pokemon   PokemonAbility[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PokemonAbility {
  pokemonId String
  abilityId String
  slot      Int
  isHidden  Boolean @default(false)
  pokemon   Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  ability   Ability @relation(fields: [abilityId], references: [id], onDelete: Restrict)

  @@id([pokemonId, abilityId])
  @@unique([pokemonId, slot])
  @@index([abilityId])
}

model PokemonEvolution {
  id            String   @id
  chainId       Int
  fromPokemonId String
  toPokemonId   String
  trigger       String?
  minLevel      Int?
  conditions    Json?
  fromPokemon   Pokemon @relation("EvolutionFrom", fields: [fromPokemonId], references: [id], onDelete: Cascade)
  toPokemon     Pokemon @relation("EvolutionTo", fields: [toPokemonId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([chainId, fromPokemonId, toPokemonId])
  @@index([fromPokemonId])
  @@index([toPokemonId])
}

model PokemonAssetReference {
  id        String   @id
  pokemonId String
  kind      String
  url       String
  isPrimary Boolean  @default(false)
  metadata  Json?
  pokemon   Pokemon  @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pokemonId, kind, url])
  @@index([pokemonId, kind])
}

model PokedexEntry {
  id           String  @id
  pokemonId    String
  text         String
  language     String
  generation   Int
  version      String
  versionLabel String
  pokemon      Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)

  @@unique([pokemonId, language, version])
  @@index([pokemonId, language, generation])
}

model Move {
  id                String   @id
  name              String
  type              String
  category          String
  names             Json?
  learnsets         PokemonLevelUpMove[]
  updatedAt         DateTime @updatedAt
  power             Int?
  accuracy          Int?
  pp                Int?
  priority          Int      @default(0)
  generation        Int?
  metadata          Json?
}

model PokemonLevelUpMove {
  pokemonId          String
  moveId             String
  referenceGeneration Int
  level              Int
  pokemon            Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  move               Move    @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@id([pokemonId, moveId, referenceGeneration, level])
  @@index([pokemonId, referenceGeneration, level])
  @@index([moveId])
}

model PokemonCatalogSync {
  key         String   @id
  version     Int
  completedAt DateTime @default(now()) @updatedAt
}

model TcgSet {
  id          String   @id
  name        String
  series      String?
  logoUrl     String?
  symbolUrl   String?
  releaseDate DateTime?
  cardCount   Int?
  metadata    Json?
  cards       TcgCard[]
  sourceUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([releaseDate])
}

model TcgCard {
  id          String   @id
  localId     String?
  setId       String
  name        String
  category    String?
  hp          Int?
  rarity      String?
  imageUrl    String?
  illustrator String?
  metadata    Json?
  set         TcgSet @relation(fields: [setId], references: [id], onDelete: Restrict)
  pokemon     TcgCardPokemon[]
  prices      TcgCardPrice[]
  sourceUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([setId])
  @@index([name])
  @@index([rarity])
}

model TcgCardPokemon {
  cardId    String
  pokemonId String
  card      TcgCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  pokemon   Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)

  @@id([cardId, pokemonId])
  @@index([pokemonId])
}

model TcgCardPrice {
  id         String   @id @default(cuid())
  cardId     String
  provider   String
  currency   String
  variant    String
  market     Decimal? @db.Decimal(12, 4)
  low        Decimal? @db.Decimal(12, 4)
  mid        Decimal? @db.Decimal(12, 4)
  high       Decimal? @db.Decimal(12, 4)
  trend      Decimal? @db.Decimal(12, 4)
  metadata   Json?
  observedAt DateTime @default(now())
  card       TcgCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, provider, currency, variant])
  @@index([observedAt])
}

model DataSyncRun {
  id             String         @id @default(cuid())
  source         DataSyncSource
  mode           DataSyncMode
  status         DataSyncStatus @default(PENDING)
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  recordsProcessed Int          @default(0)
  inserted       Int            @default(0)
  updated        Int            @default(0)
  skipped        Int            @default(0)
  error          String?
  details        Json?
  createdAt      DateTime       @default(now())

  @@index([source, createdAt])
  @@index([status])
}

model DataSyncState {
  source          DataSyncSource @id
  datasetVersion  String?
  lastSuccessAt   DateTime?
  lastAttemptAt   DateTime?
  lastFullSyncAt  DateTime?
  recordsAvailable Int           @default(0)
  lastError       String?
  metadata        Json?
  updatedAt       DateTime       @updatedAt
}
