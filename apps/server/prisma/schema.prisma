generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  username     String             @unique
  email        String             @unique
  passwordHash String
  avatarSeed   String             @default("")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  stats        UserStats?
  gameStats    UserGameStats[]
  results      PlayerGameResult[]
}

model UserStats {
  userId       String @id
  gamesPlayed  Int    @default(0)
  gamesWon     Int    @default(0)
  totalPoints  Int    @default(0)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserGameStats {
  id           String @id @default(cuid())
  userId       String
  gameId       String
  gamesPlayed  Int    @default(0)
  gamesWon     Int    @default(0)
  metrics      Json
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model GameHistory {
  id          String             @id @default(cuid())
  roomCode    String
  gameId      String
  playerCount Int
  config      Json
  startedAt   DateTime
  endedAt     DateTime           @default(now())
  results     PlayerGameResult[]

  @@index([gameId, endedAt])
}

model PlayerGameResult {
  id          String      @id @default(cuid())
  historyId   String
  userId      String?
  displayName String
  position    Int
  points      Int
  metrics     Json
  history     GameHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Pokemon {
  id                String   @id
  nationalDexNumber Int      @unique
  name              String
  generation        Int
  sprite            String
  hp                Int      @default(0)
  attack            Int      @default(0)
  defense           Int      @default(0)
  specialAttack     Int      @default(0)
  specialDefense    Int      @default(0)
  speed             Int      @default(0)
  baseStatTotal     Int      @default(0)
  names             Json?
  types             String[]
  updatedAt         DateTime @updatedAt

  @@index([generation])
}
