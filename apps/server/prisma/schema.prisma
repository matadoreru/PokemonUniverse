generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  username     String             @unique
  email        String             @unique
  passwordHash String
  avatarSeed   String             @default("")
  avatarType   String             @default("DEFAULT")
  avatarValue  String?
  avatarVersion Int               @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  stats        UserStats?
  gameStats    UserGameStats[]
  results      PlayerGameResult[]
}

model UserStats {
  userId       String @id
  gamesPlayed  Int    @default(0)
  gamesWon     Int    @default(0)
  totalPoints  Int    @default(0)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserGameStats {
  id           String @id @default(cuid())
  userId       String
  gameId       String
  gamesPlayed  Int    @default(0)
  gamesWon     Int    @default(0)
  points       Int    @default(0)
  metrics      Json
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId])
}

model GameHistory {
  id          String             @id @default(cuid())
  resultId    String             @unique
  roomCode    String
  gameId      String
  playerCount Int
  config      Json
  startedAt   DateTime
  endedAt     DateTime           @default(now())
  results     PlayerGameResult[]

  @@index([gameId, endedAt])
}

model PlayerGameResult {
  id          String      @id @default(cuid())
  historyId   String
  userId      String?
  displayName String
  position    Int
  points      Int
  metrics     Json
  history     GameHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Pokemon {
  id                String   @id
  nationalDexNumber Int
  name              String
  generation        Int
  isDefault         Boolean  @default(true)
  sprite            String
  hp                Int      @default(0)
  attack            Int      @default(0)
  defense           Int      @default(0)
  specialAttack     Int      @default(0)
  specialDefense    Int      @default(0)
  speed             Int      @default(0)
  baseStatTotal     Int      @default(0)
  heightDecimeters Int      @default(0)
  weightHectograms Int      @default(0)
  legendaryStatus String   @default("NORMAL")
  color             String   @default("unknown")
  abilities         String[]
  names             Json?
  types             String[]
  evolutionStage    Int?
  evolutionStages   Int?
  levelUpMoves      PokemonLevelUpMove[]
  pokedexEntries    PokedexEntry[]
  updatedAt         DateTime @updatedAt

  @@index([generation])
  @@index([nationalDexNumber])
}

model PokedexEntry {
  id           String  @id
  pokemonId    String
  text         String
  language     String
  generation   Int
  version      String
  versionLabel String
  pokemon      Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)

  @@unique([pokemonId, language, version])
  @@index([pokemonId, language, generation])
}

model Move {
  id                String   @id
  name              String
  type              String
  category          String
  names             Json?
  learnsets         PokemonLevelUpMove[]
  updatedAt         DateTime @updatedAt
}

model PokemonLevelUpMove {
  pokemonId          String
  moveId             String
  referenceGeneration Int
  level              Int
  pokemon            Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  move               Move    @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@id([pokemonId, moveId, referenceGeneration, level])
  @@index([pokemonId, referenceGeneration, level])
  @@index([moveId])
}

model PokemonCatalogSync {
  key         String   @id
  version     Int
  completedAt DateTime @default(now()) @updatedAt
}
